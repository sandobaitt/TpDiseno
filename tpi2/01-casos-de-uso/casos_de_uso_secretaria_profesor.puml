@startuml casos_de_uso_secretaria_profesor
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam actorStyle awesome

' ==============================================================================
' DIAGRAMA DE CASOS DE USO: actores Secretaria y Profesor
' Sistema SquatGym
' Cátedra: Diseño de Sistemas (DSI 2026) - TPI, segunda entrega
'
' Versión del grupo (dibujada en draw.io) pasada a PlantUML.
'
' REGLAS DE CÁTEDRA APLICADAS:
' - Actores (roles) a la izquierda y afuera del límite del sistema.
' - Actor externo (Entidad Bancaria) a la derecha.
' - Secretaria y Profesor heredan de Usuario: lo que hacen los dos se asocia a Usuario.
' - Asociaciones actor - CU sin flechas.
' - CU nombrados con verbo en infinitivo + sustantivo.
' - include apunta al CU incluido; extend apunta al CU base.
' - Sin CU huérfanos: los que no tienen actor directo cuelgan de un include o extend.
' ==============================================================================

actor "Usuario" as Usuario
actor "Secretaria" as Secretaria
actor "Profesor" as Profesor
actor "Entidad Bancaria" as Banco <<Sistema Externo>>

' Generalización: los dos roles son usuarios del sistema
Secretaria -up-|> Usuario
Profesor -up-|> Usuario

rectangle "SquatGym" {

    ' --- Lo que hacen la Secretaria y el Profesor (actor Usuario) ---
    usecase "Registrar Asistencia\nde Alumnos" as RegistrarAsistencia
    usecase "Verificar Habilitación\npara Ingresar a Clase" as VerificarHabilitacion

    ' --- Secretaria ---
    usecase "Registrar Pagos" as RegistrarPagos
    usecase "Emitir Recibos" as EmitirRecibos
    usecase "Aplicar Promociones" as AplicarPromociones
    usecase "Registrar Alumnos" as RegistrarAlumnos
    usecase "Editar Datos\nde Alumnos" as EditarAlumnos
    usecase "Restringir Acceso\nal Alumno" as RestringirAcceso
    usecase "Gestionar Asistencia\nProfesor" as GestionarAsistenciaProfesor
    usecase "Visualizar Estado\ndel Alumno" as VisualizarEstado
    usecase "Registrar Ventas\nKiosco" as RegistrarVentasKiosco
    usecase "Actualizar Stock" as ActualizarStock
    usecase "Consultar Cronograma" as ConsultarCronograma
    usecase "Consultar Detalle\nde Clase" as ConsultarDetalleClase
    usecase "Cargar Observaciones" as CargarObservaciones
    usecase "Enviar Notificaciones" as EnviarNotificaciones

    ' --- Profesor ---
    usecase "Visualizar Cronograma\nde Clases" as VisualizarCronograma
    usecase "Recibir Notificaciones sobre\nCambios o Reemplazos" as RecibirNotificaciones
    usecase "Realizar Observaciones sobre\nAlumnos o Jornada" as RealizarObservaciones
    usecase "Consultar Historial de\nHoras Trabajadas" as ConsultarHoras

    ' La asistencia no se registra sin verificar la habilitación de cada alumno
    RegistrarAsistencia ..> VerificarHabilitacion : <<include>>
    ' Todo pago genera su recibo
    RegistrarPagos ..> EmitirRecibos : <<include>>
    ' Al cobrar, la promoción se aplica solo si corresponde
    AplicarPromociones ..> RegistrarPagos : <<extend>>
    ' Desde el cronograma, opcionalmente se consulta el detalle de una clase
    ConsultarDetalleClase ..> ConsultarCronograma : <<extend>>
}

' Asociaciones SIN flechas
Usuario -- RegistrarAsistencia

Secretaria -- RegistrarPagos
Secretaria -- RegistrarAlumnos
Secretaria -- EditarAlumnos
Secretaria -- RestringirAcceso
Secretaria -- GestionarAsistenciaProfesor
Secretaria -- VisualizarEstado
Secretaria -- RegistrarVentasKiosco
Secretaria -- ActualizarStock
Secretaria -- ConsultarCronograma
Secretaria -- CargarObservaciones
Secretaria -- EnviarNotificaciones

Profesor -- VisualizarCronograma
Profesor -- RecibirNotificaciones
Profesor -- RealizarObservaciones
Profesor -- ConsultarHoras

' Actor externo, a la derecha
RegistrarPagos -down- Banco

@enduml
