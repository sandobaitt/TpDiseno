@startuml casos_de_uso_secretaria_profesor
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam actorStyle awesome

' ==============================================================================
' DIAGRAMA DE CASOS DE USO: actores Secretaria y Profesor
' Sistema SquatGym - módulos Gestión de Alumnos y Gestión de Personal
' Cátedra: Diseño de Sistemas (DSI 2026) - TPI, segunda entrega
'
' REGLAS DE CÁTEDRA APLICADAS:
' - Actores (roles) a la izquierda y afuera del límite del sistema.
' - Asociaciones actor - CU sin flechas.
' - CU nombrados con verbo en infinitivo + sustantivo.
' - include apunta al CU incluido; extend apunta al CU base.
' - Sin CU huérfanos: los que no tienen actor directo cuelgan de un include o extend.
' ==============================================================================

actor "Secretaria" as Secretaria
actor "Profesor" as Profesor

rectangle "Sistema SquatGym" {

    package "Gestión de Alumnos" {
        usecase "CU-A01\nRegistrar Inscripción\nde Alumno" as A01
        usecase "CU-A02\nCompletar Declaración\nJurada de Salud" as A02
        usecase "CU-A03\nConsultar Estado\nde Cuenta" as A03
        usecase "CU-A04\nRegistrar Pago\nde Cuota" as A04
        usecase "CU-A09\nAplicar Promoción\no Descuento" as A09
        usecase "CU-A05\nAplicar Restricción\nde Acceso por Deuda" as A05
        usecase "CU-A06\nGestionar Asistencia Diaria\npor Clase y Sede" as A06
        usecase "CU-A13\nVerificar Habilitación\npara Ingresar a Clase" as A13
        usecase "CU-A14\nEnviar Notificación\na Alumnos" as A14
    }

    package "Gestión de Personal" {
        usecase "CU-P01\nRegistrar Asistencia\nde Profesor" as P01
        usecase "CU-P04\nRegistrar Novedad\nInterna" as P04
        usecase "CU-P06\nConsultar Horas\nTrabajadas" as P06
        usecase "CU-P10\nDetectar Diferencias entre\nHoras y Cronograma" as P10
        usecase "CU-P07\nNotificar Cambio de\nHorario o Reemplazo" as P07
        usecase "CU-P08\nConfirmar o Rechazar\nReemplazo" as P08
        usecase "CU-P09\nRegistrar Observaciones\nde Jornada" as P09
    }

    ' La inscripción no se completa sin la declaración jurada de salud
    A01 ..> A02 : <<include>>
    ' Al cobrar, la promoción se aplica solo si corresponde
    A09 ..> A04 : <<extend>>
    ' La asistencia por clase verifica la habilitación de cada alumno
    A06 ..> A13 : <<include>>
    ' Al consultar las horas, el sistema compara con el cronograma
    P06 ..> P10 : <<include>>
}

' Asociaciones SIN flechas
Secretaria -- A01
Secretaria -- A03
Secretaria -- A04
Secretaria -- A05
Secretaria -- A06
Secretaria -- A13
Secretaria -- A14
Secretaria -- P01
Secretaria -- P04

Profesor -- A06
Profesor -- P06
Profesor -- P07
Profesor -- P08
Profesor -- P09

note right of P07
  Lo inicia el sistema cuando cambia
  la agenda del profesor o se le asigna
  un reemplazo; el profesor lo recibe.
end note

@enduml
