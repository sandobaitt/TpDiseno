@startuml 2_clases_registrar_pagos
!pragma layout smetana
skinparam shadowing false
skinparam roundcorner 8
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontSize 13
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #444444
skinparam PackageBorderColor #999999
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #BBAA55

' ==============================================================================
' DIAGRAMA DE CLASES: Realización de Registrar Pagos, con su include (Emitir Recibos)
' y su extend (Aplicar Promociones)
' Sistema SquatGym - Cátedra: Diseño de Sistemas (DSI 2026) - TPI, segunda entrega
'
' REGLAS DEL APUNTE APLICADAS:
' - Solo las clases que participan en el CU y en su include y su extend (camino estándar). La Entidad Bancaria
'   es actor externo: no es una clase del sistema.
' - UI y controladores (CTRL, CTRLSesion) SIN atributos.
' - Clases en singular. Dominio con atributos privados (-) tipados y métodos públicos (+).
' - Todo mensaje que recibe una clase en la secuencia figura como método acá
'   (tpi2/verificar.py). Los create() de listas temporales y el destroy() de la UI
'   no se listan, igual que las búsquedas indexadas sobre colecciones.
' - Relaciones: dependencia, asociación (navegabilidad y multiplicidad),
'   agregación (colecciones del Sistema) y composición (Alumno ◆— Cuota).
' ==============================================================================

package "Presentación y control" {

    class UIRegistrarPagos <<Boundary>> {
        + mostrarOpciones(): void
        + seleccionarOpcionRegistrarPagos(): void
        + solicitarDniONombre(): void
        + ingresarDni(dni: String): void
        + mostrarEstadoDeCuenta(alumno: Alumno, cuotasPendientes: List): void
        + seleccionarCuota(idCuota: int): void
        + solicitarContinuarSeleccion(): void
        + indicarContinuar(continuar: boolean): void
        + mostrarMontoYMediosDePago(montoTotal: float, mediosPago: List<MedioPago>): void
        + seleccionarMedioPago(medioPago: MedioPago): void
        + mostrarResumenCobro(alumno: Alumno, cuotas: List, montoTotal: float, medioPago: MedioPago): void
        + confirmarPago(): void
        + mostrarPagoRegistrado(recibo: Recibo): void
    }

    class CTRLRegistrarPagos <<Control>> {
        + iniciarRegistroPago(): void
        + tomarDni(dni: String): void
        + tomarCuota(idCuota: int): void
        + tomarContinuar(continuar: boolean): void
        + tomarMedioPago(medioPago: MedioPago): void
        + tomarConfirmacion(): void
    }

    class UIAplicarPromociones <<Boundary>> {
        + mostrarOpciones(): void
        + solicitarPromocion(): void
        + mostrarPromocionesVigentes(promociones: List): void
        + seleccionarPromocion(idPromocion: int): void
        + mostrarNuevoMonto(montoTotal: float): void
    }

    class CTRLAplicarPromociones <<Control>> {
        + iniciarAplicacionPromocion(alumno: Alumno, montoTotal: float, medioPago: MedioPago): void
        + tomarPromocion(idPromocion: int): void
    }

    class UIEmitirRecibos <<Boundary>> {
        + mostrarOpciones(): void
        + solicitarRecibo(idPago: int): void
        + mostrarRecibo(recibo: Recibo): void
    }

    class CTRLEmitirRecibos <<Control>> {
        + iniciarEmisionRecibo(idPago: int): void
    }

    class CTRLSesion <<Control>> {
        + obtenerUsuarioLogueado(): Secretaria
    }

    class Sistema <<Sistema>> {
        - promocionAplicada: Promocion
        + obtenerAlumno(dni: String): Alumno
        + obtenerCuotasPendientes(alumno: Alumno): List
        + iniciarSeleccionCuotas(): void
        + agregarCuotaSeleccionada(idCuota: int): void
        + obtenerMontoTotal(): float
        + obtenerMediosPago(): List<MedioPago>
        + obtenerCuotasSeleccionadas(): List
        + confirmarPago(alumno: Alumno, montoTotal: float, medioPago: MedioPago, secretaria: Secretaria): Recibo
        + obtenerPromocionesVigentes(alumno: Alumno, montoTotal: float, medioPago: MedioPago): List
        + aplicarPromocion(idPromocion: int, montoTotal: float): float
        + obtenerPago(idPago: int): Pago
        + emitirRecibo(pago: Pago): Recibo
        - calcularTotal(): float
        - recalcularMontoTotal(montoTotal: float, descuento: float): float
        - registrarPromocionAplicada(promocion: Promocion): void
        - generarNumeroRecibo(): int
    }
}

package "Dominio" {

    class Alumno <<Entity>> {
        - idAlumno: int
        - dni: String
        - nombre: String
        - apellido: String
        - estado: EstadoAlumno
        - estadoCuenta: EstadoCuenta
        + getCuota(): List
        + actualizarEstadoCuenta(): void
    }

    class Cuota <<Entity>> {
        - idCuota: int
        - periodo: String
        - importe: float
        - fechaVencimiento: Date
        - estado: EstadoCuota
        + marcarPagada(): void
    }

    class Pago <<Entity>> {
        - idPago: int
        - fechaHora: DateTime
        - montoTotal: float
        - medioPago: MedioPago
        + create(): void
        + setDatos(datosPago: DatosPago): void
        + setAlumno(alumno: Alumno): void
        + setSecretaria(secretaria: Secretaria): void
        + setPromocion(promocion: Promocion): void
        + agregarCuota(cuota: Cuota): void
    }

    class Recibo <<Entity>> {
        - nroRecibo: int
        - fechaEmision: DateTime
        + create(): void
        + setDatos(datosRecibo: DatosRecibo): void
        + setPago(pago: Pago): void
    }

    class Promocion <<Entity>> {
        - idPromocion: int
        - nombre: String
        - porcentajeDescuento: float
        - fechaDesde: Date
        - fechaHasta: Date
        + verificarCondiciones(alumno: Alumno, montoTotal: float, medioPago: MedioPago): String
        + calcularDescuento(montoTotal: float): float
    }

    class Secretaria <<Entity>> {
        - idUsuario: int
        - nombre: String
        - apellido: String
        - legajo: int
    }
}

package "Tipos enumerados" {
    enum EstadoAlumno <<enumeration>> {
        ACTIVO
        INACTIVO
    }

    enum EstadoCuenta <<enumeration>> {
        AL_DIA
        POR_VENCER
        DEUDOR
        BLOQUEADO
    }

    enum EstadoCuota <<enumeration>> {
        PENDIENTE
        PAGADA
    }

    enum MedioPago <<enumeration>> {
        EFECTIVO
        TARJETA_DEBITO
        TRANSFERENCIA
        QR
    }
}

' ------------------------------------------------------------------------------
' RELACIONES
' ------------------------------------------------------------------------------

' Presentación y control
UIRegistrarPagos "1" -- "1" CTRLRegistrarPagos
CTRLRegistrarPagos "1" --> "1" CTRLSesion : consulta la sesión
CTRLRegistrarPagos "1" --> "1" Sistema : delega operaciones
UIAplicarPromociones "1" -- "1" CTRLAplicarPromociones
CTRLAplicarPromociones "1" --> "1" Sistema : delega operaciones
UIEmitirRecibos "1" -- "1" CTRLEmitirRecibos
CTRLEmitirRecibos "1" --> "1" Sistema : delega operaciones

' Colecciones que conoce el Sistema (agregación)
Sistema "1" o-- "*" Alumno : alumnos
Sistema "1" o-- "*" Pago : pagos
Sistema "1" o-- "*" Recibo : recibos
Sistema "1" o-- "*" Promocion : promociones

' Dominio (con la dirección de cada flecha, para que el dibujo quede ordenado)
Pago "*" -left-> "1" Alumno : realizado por
Recibo "1" -left-> "1" Pago : comprobante de
Alumno "1" *-down- "*" Cuota : cuotas
Pago "1" -down-> "1..*" Cuota : cuotas pagadas
Pago "*" -down-> "1" Secretaria : cobrado por
Pago "*" -down-> "0..1" Promocion : promoción aplicada
Promocion ..> Alumno : evalúa condiciones de

Secretaria -[hidden]down- MedioPago
Cuota -[hidden]down- EstadoCuota

legend bottom
  **Referencias**
  EstadoAlumno (activo o inactivo), EstadoCuenta (al día, por vencer, deudor o bloqueado), EstadoCuota (pendiente o pagada)
  y MedioPago (efectivo, tarjeta de débito, transferencia o QR) son tipos enumerados.
  Son tipos y no clases con responsabilidades: no tienen tarjeta CRC.
  DatosPago agrupa fecha y hora, monto total y medio de pago. DatosRecibo agrupa número y fecha de emisión.
  (No son clases del dominio: se usan para setear varios datos de una vez.)
  Promocion.verificarCondiciones devuelve "aplica" o el motivo por el que no corresponde.
  Las listas temporales (cuotas pendientes, cuotas seleccionadas y promociones vigentes) las crea, llena y destruye el Sistema.
  La Entidad Bancaria es un actor externo: no es una clase del sistema.
endlegend

@enduml
