@startuml 4_secuencia_registrar_asistencia_alumnos
!pragma layout smetana
autonumber
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' REALIZACIÓN DEL CASO DE USO: Registrar Asistencia de Alumnos
' Sistema SquatGym - Cátedra: Diseño de Sistemas (DSI 2026) - TPI, segunda entrega
'
' REGLAS DE CÁTEDRA APLICADAS:
' - Solo camino estándar (actor: Secretaria).
' - CTRLSesion preexistente provee la secretaria logueada (sin create).
' - Los loops los hace el Sistema sobre LTS: Sedes, LTC: Clases y LTA: Alumnos.
' - Listas temporales LTTS / LTTC / LTTA creadas, llenadas y destruidas por Sistema.
' - Búsquedas indexadas para objetos puntuales: getClase(idClase), getAlumno(idAlumno).
' - Comparaciones por atributo en las guardas, sin getters extra.
' - Experto: el alumno sabe si cursa la actividad (delega en su plan) y si está habilitado.
' - Paso 6 incluye Verificar Habilitación para Ingresar a Clase.
' - Composición: RegistroAsistencia crea sus DetalleAsistencia (el Sistema no los crea).
' - El CTRL destruye la UI al finalizar.
' ==============================================================================

actor "Secretaria" as Actor
boundary "PantallaRegistrarAsistencia" as UI <<Boundary>>
control "CTRLRegistrarAsistencia" as CTRLCU <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
participant "LTS: Sedes" as LTS <<Entity>>
participant "LTC: Clases" as LTC <<Entity>>
participant "LTA: Alumnos" as LTA <<Entity>>
participant "pl: Plan" as Plan <<Entity>>
participant "LTTS: Sedes" as LTTS
participant "LTTC: Clases" as LTTC
participant "LTTA: Alumnos" as LTTA
participant "reg: RegistroAsistencia" as Registro <<Entity>>
participant "det: DetalleAsistencia" as Detalle <<Entity>>

== Pasos 1 y 2: La secretaria elige registrar la asistencia y el sistema muestra las sedes activas ==
Actor -> UI: seleccionarOpcionRegistrarAsistencia()
activate UI
UI -> CTRLCU: iniciarRegistroAsistencia()
activate CTRLCU

CTRLCU -> CTRLSesion: obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRLCU: sec
deactivate CTRLSesion

CTRLCU -> Sistema: obtenerSedesActivas()
activate Sistema

create LTTS
Sistema -> LTTS: create()

loop for each s in LTS
    Sistema -> LTS: getSede()
    activate LTS
    LTS --> Sistema: s
    deactivate LTS

    opt s.estado = activa
        Sistema -> LTTS: add(s)
    end
end

Sistema --> CTRLCU: LTTS
Sistema -> LTTS: destroy()
destroy LTTS
deactivate Sistema

CTRLCU -> UI: mostrarSedes(LTTS, sec.sede, fechaActual)
UI --> Actor: sedes activas, con la sede y la fecha propuestas

== Paso 3: La secretaria selecciona la sede y la fecha ==
Actor -> UI: seleccionarSedeYFecha(idSede, fecha)
UI -> CTRLCU: tomarSedeYFecha(idSede, fecha)

== Paso 4: El sistema busca y muestra las clases programadas de la sede para ese día ==
CTRLCU -> Sistema: obtenerClasesDelDia(idSede, fecha)
activate Sistema

Sistema -> Sistema: calcularDiaSemana(fecha)

create LTTC
Sistema -> LTTC: create()

loop for each c in LTC
    Sistema -> LTC: getClase()
    activate LTC
    LTC --> Sistema: c
    deactivate LTC

    opt c.sede.idSede = idSede y c.diaSemana = diaSemana
        Sistema -> LTTC: add(c)
    end
end

Sistema --> CTRLCU: LTTC
Sistema -> LTTC: destroy()
destroy LTTC
deactivate Sistema

CTRLCU -> UI: mostrarClases(LTTC)
UI --> Actor: clases del día con actividad, horario y profesor

== Paso 5: La secretaria selecciona una clase ==
Actor -> UI: seleccionarClase(idClase)
UI -> CTRLCU: tomarClase(idClase)

== Paso 6: El sistema busca los alumnos de la clase y verifica su habilitación (incluye Verificar Habilitación para Ingresar a Clase) ==
CTRLCU -> Sistema: obtenerAlumnosDeClase(idClase, fecha)
activate Sistema

' Búsqueda indexada: un objeto puntual conocido por su id
Sistema -> LTC: getClase(idClase)
activate LTC
LTC --> Sistema: c
deactivate LTC

create LTTA
Sistema -> LTTA: create()

loop for each a in LTA
    Sistema -> LTA: getAlumno()
    activate LTA
    LTA --> Sistema: a
    deactivate LTA

    opt a.estado = activo
        ' Experto: el alumno delega en su plan si la actividad está incluida
        Sistema -> LTA: cursaActividad(c.actividad)
        activate LTA
        LTA -> Plan: incluyeActividad(c.actividad)
        activate Plan
        Plan --> LTA: incluye
        deactivate Plan
        LTA --> Sistema: cursa
        deactivate LTA

        opt cursa = verdadero
            ' CU incluido Verificar Habilitación: restricción manual y días de atraso contra el umbral configurable
            Sistema -> LTA: verificarHabilitacion(fecha, diasBloqueoDeuda)
            activate LTA
            LTA -> LTA: calcularDiasAtraso(fecha)
            LTA --> Sistema: habilitacion
            deactivate LTA

            Sistema -> LTTA: add(a, habilitacion)
        end
    end
end

Sistema --> CTRLCU: LTTA
Sistema -> LTTA: destroy()
destroy LTTA
deactivate Sistema

CTRLCU -> UI: mostrarAlumnos(LTTA)
UI --> Actor: alumnos de la clase con su habilitación

== Paso 7: La secretaria indica la asistencia de cada alumno ==
loop por cada alumno de la lista
    Actor -> UI: indicarAsistencia(idAlumno, estado)
end
Actor -> UI: terminarCarga()
UI -> CTRLCU: tomarAsistencias(asistencias)

== Paso 8: El sistema muestra el resumen y solicita confirmación ==
CTRLCU -> UI: solicitarConfirmacion(asistencias)
UI --> Actor: resumen de presentes, ausentes y ausentes con justificación

== Paso 9: La secretaria confirma el registro ==
Actor -> UI: confirmarRegistro()
UI -> CTRLCU: tomarConfirmacion()

== Paso 10: El sistema registra la asistencia con quién la cargó y cuándo ==
CTRLCU -> Sistema: registrarAsistencia(idClase, fecha, asistencias, sec)
activate Sistema

Sistema -> LTC: getClase(idClase)
activate LTC
LTC --> Sistema: c
deactivate LTC

create Registro
Sistema -> Registro: create(c, fecha, sec, fechaHoraActual)

loop for each item in asistencias
    Sistema -> LTA: getAlumno(item.idAlumno)
    activate LTA
    LTA --> Sistema: a
    deactivate LTA

    ' Composición: la cabecera crea cada detalle
    Sistema -> Registro: agregarDetalle(a, item.estado)
    activate Registro
    create Detalle
    Registro -> Detalle: create(a, item.estado)
    deactivate Registro
end

Sistema --> CTRLCU: reg
deactivate Sistema

CTRLCU -> UI: mostrarAsistenciaRegistrada(reg)
UI --> Actor: asistencia registrada

CTRLCU -> UI: destroy()
destroy UI
deactivate CTRLCU

@enduml
