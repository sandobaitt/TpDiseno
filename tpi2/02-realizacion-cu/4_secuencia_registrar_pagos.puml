@startuml 4_secuencia_registrar_pagos
!pragma layout smetana
autonumber
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' REALIZACIÓN DEL CASO DE USO: Registrar Pagos
' Sistema SquatGym - Cátedra: Diseño de Sistemas (DSI 2026) - TPI, segunda entrega
'
' REGLAS DEL APUNTE ACTUALIZADO APLICADAS:
' - Solo camino estándar (actor: Secretaria; pago con tarjeta de débito y sin promoción).
' - UI<CU> y CTRL<CU>. CTRLSesion preexistente (sin create) provee la secretaria logueada.
' - Búsqueda indexada del alumno por DNI (Alumnos.getAlumno(dni)), sin loop.
' - Recorrido de las cuotas: LL[c]: Cuotas; el loop lo hace el Sistema y compara el DNI del alumno.
' - Listas temporales LT + letra (LTP[c]: Cuotas = pendientes, LTS[c]: Cuotas = seleccionadas): creadas, llenadas y destruidas por el Sistema.
' - Ingreso múltiple: la secretaria selecciona UNA cuota por vuelta (nunca una lista) y en cada vuelta
'   responde si sigue ingresando cuotas; esa respuesta decide si el loop continúa.
'   Como el CTRL no tiene atributos, el Sistema acumula las cuotas elegidas en
'   LTS[c]: Cuotas (se crea con iniciarSeleccionCuotas()).
' - Mensaje reflexivo para el cálculo del total (Sistema -> Sistema).
' - Alta de entidades: create() y después los sets, siempre desde el Sistema.
' - Cambio de estado de la cuota con un mensaje de negocio (marcarPagada()).
' - La Entidad Bancaria es actor externo: la invoca el Sistema con mensaje asíncrono.
' - Include y extend con ref: Emitir Recibos (paso 12) y Aplicar Promociones (paso 7,
'   camino alternativo 7.a). Cada uno tiene su propio diagrama de secuencia
'   (4b_secuencia_emitir_recibos y 4c_secuencia_aplicar_promociones).
' - Inicio y fin: un participante Externo (algo ajeno al CU) le manda create() al CTRL; el CTRL
'   crea la UI y le pide mostrarOpciones(). Al final el CTRL destruye la UI y el Externo destruye al CTRL.
' ==============================================================================

participant "Externo" as Externo
actor "Secretaria" as Actor
boundary "UIRegistrarPagos" as UI <<Boundary>>
control "CTRLRegistrarPagos" as CTRLCU <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
participant "Alumnos" as Alumnos <<Entity>>
participant "a: Alumno" as Alumno <<Entity>>
participant "LL[c]: Cuotas" as LLC <<Entity>>
participant "c: Cuota" as Cuota <<Entity>>
participant "LTP[c]: Cuotas" as LTP
participant "LTS[c]: Cuotas" as LTS
participant "p: Pago" as Pago <<Entity>>
participant "r: Recibo" as Recibo <<Entity>>
actor "Entidad Bancaria" as Banco

== Inicio: algo externo crea el controlador, este crea la pantalla y le pide mostrar las opciones ==
create CTRLCU
Externo -> CTRLCU: create()
activate CTRLCU
create UI
CTRLCU -> UI: create()
activate UI
CTRLCU -> UI: mostrarOpciones()
UI --> Actor: opciones disponibles

== Pasos 1 y 2: La secretaria elige registrar pagos y el sistema solicita el DNI o el nombre del alumno ==
Actor -> UI: seleccionarOpcionRegistrarPagos()
UI -> CTRLCU: iniciarRegistroPago()
CTRLCU -> UI: solicitarDniONombre()
UI --> Actor: solicita DNI o nombre del alumno

== Paso 3: La secretaria ingresa el DNI del alumno ==
Actor -> UI: ingresarDni(dni)
UI -> CTRLCU: tomarDni(dni)

== Paso 4: El sistema busca al alumno, muestra su estado de cuenta y solicita las cuotas a pagar ==
CTRLCU -> Sistema: obtenerAlumno(dni)
activate Sistema
' Búsqueda indexada: un objeto puntual conocido por su DNI
Sistema -> Alumnos: getAlumno(dni)
activate Alumnos
Alumnos --> Sistema: a
deactivate Alumnos
Sistema --> CTRLCU: a
deactivate Sistema

CTRLCU -> Sistema: obtenerCuotasPendientes(dni)
activate Sistema

create LTP
Sistema -> LTP: create()

loop for each c in Cuotas
    Sistema -> LLC: getCuota()
    activate LLC
    LLC --> Sistema: c
    deactivate LLC

    ' Cuotas adeudadas y próximas a vencer del alumno: mismo DNI y todavía impagas
    opt c.alumno.dni = dni y c.estado = pendiente
        Sistema -> LTP: add(c)
    end
end

Sistema --> CTRLCU: LTP[c]
Sistema -> LTP: destroy()
destroy LTP
deactivate Sistema

' Lista de las cuotas del pago en curso: la completa el paso 5
CTRLCU -> Sistema: iniciarSeleccionCuotas()
activate Sistema
create LTS
Sistema -> LTS: create()
deactivate Sistema

CTRLCU -> UI: mostrarEstadoDeCuenta(a, LTP[c])
UI --> Actor: a, LTP[c]

== Paso 5: La secretaria selecciona las cuotas a pagar, una por vez, hasta que indica que no sigue ==
loop mientras la secretaria responda que quiere seguir ingresando cuotas
    Actor -> UI: seleccionarCuota(idCuota)
    UI -> CTRLCU: tomarCuota(idCuota)

    CTRLCU -> Sistema: agregarCuotaSeleccionada(idCuota)
    activate Sistema
    ' Búsqueda indexada sobre las cuotas
    Sistema -> LLC: getCuota(idCuota)
    activate LLC
    LLC --> Sistema: c
    deactivate LLC
    Sistema -> LTS: add(c)
    deactivate Sistema

    ' El loop continúa o termina según la respuesta de la secretaria
    CTRLCU -> UI: solicitarContinuarSeleccion()
    UI --> Actor: ¿seguir ingresando cuotas?
    Actor -> UI: indicarContinuar(continuar)
    UI -> CTRLCU: tomarContinuar(continuar)
end

== Paso 6: El sistema calcula el monto total y solicita el medio de pago ==
CTRLCU -> Sistema: obtenerMontoTotal()
activate Sistema
Sistema -> Sistema: calcularTotal()
Sistema --> CTRLCU: montoTotal
deactivate Sistema

CTRLCU -> UI: mostrarMontoYMediosDePago(montoTotal)
UI --> Actor: monto total y medios de pago (efectivo, débito, transferencia, QR)

== Paso 7: La secretaria selecciona tarjeta de débito como medio de pago y ninguna promoción ==
Actor -> UI: seleccionarMedioPago(medioPago)
UI -> CTRLCU: tomarMedioPago(medioPago)

' Extend: comportamiento opcional. Camino estándar = sin promoción (camino alternativo 7.a)
opt la secretaria solicita aplicar una promoción o un cupón
    ref over CTRLCU, Sistema
        Aplicar Promociones (extend)
        Deja la promoción elegida en el Sistema y el monto total recalculado con el descuento
    end ref
end

== Paso 8: El sistema muestra el resumen del cobro ==
CTRLCU -> Sistema: obtenerCuotasSeleccionadas()
activate Sistema
Sistema --> CTRLCU: LTS[c]
deactivate Sistema

CTRLCU -> UI: mostrarResumenCobro(a, LTS[c], montoTotal, medioPago)
UI --> Actor: resumen del cobro (alumno, cuotas, monto total y medio de pago)

== Paso 9: La secretaria confirma la operación ==
Actor -> UI: confirmarPago()
UI -> CTRLCU: tomarConfirmacion()

== Pasos 10 y 11: El sistema solicita la validación del pago a la Entidad Bancaria y esta lo valida ==
CTRLCU -> CTRLSesion: obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRLCU: sec
deactivate CTRLSesion

CTRLCU -> Sistema: confirmarPago(a, montoTotal, medioPago, sec)
activate Sistema

Sistema ->> Banco: validarPago(a, montoTotal, medioPago)
activate Banco
Banco --> Sistema: pagoValidado
deactivate Banco

== Paso 12: El sistema registra el pago, actualiza el estado de cuenta, emite el recibo (incluye Emitir Recibos) e informa ==
create Pago
Sistema -> Pago: create()
Sistema -> Pago: setDatos(datosPago)
Sistema -> Pago: setAlumno(a)
Sistema -> Pago: setSecretaria(sec)

note right of Pago
  datosPago: fecha y hora, monto total
  y medio de pago.
end note

' Extend: solo si en el paso 7 se aplicó una promoción
opt hay una promoción aplicada
    Sistema -> Pago: setPromocion(promocionAplicada)
end

loop for each c in LTS[c]
    Sistema -> LTS: getCuota()
    activate LTS
    LTS --> Sistema: c
    deactivate LTS

    Sistema -> Pago: agregarCuota(c)
    ' El cambio de estado lo hace la cuota con un mensaje de negocio
    Sistema -> Cuota: marcarPagada()
end

' El alumno recalcula su estado de cuenta con sus cuotas
Sistema -> Alumno: actualizarEstadoCuenta()
activate Alumno
deactivate Alumno

' Include: sin Emitir Recibos el pago no se completa
ref over Sistema, Recibo
    Emitir Recibos (include)
    emitirRecibo(p): el Sistema genera el recibo r del pago p
end ref

Sistema -> LTS: destroy()
destroy LTS

Sistema --> CTRLCU: r
deactivate Sistema

CTRLCU -> UI: mostrarPagoRegistrado(r)
UI --> Actor: pago registrado y recibo digital

CTRLCU -> UI: destroy()
destroy UI
Externo -> CTRLCU: destroy()
destroy CTRLCU

@enduml
